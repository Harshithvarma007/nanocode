{
  "name": "nanocode-desktop",
  "productName": "nanocode",
  "version": "0.1.0",
  "description": "A desktop app for the nanocode coding agent",
  "main": "out/main/index.js",
  "author": "nanocode",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "web": "node dev/web.mjs",
    "web:mock": "node dev/web.mjs --mock",
    "bridge": "node dev/ws-bridge.mjs",
    "mock": "node dev/mock-engine.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && node scripts/check-engine.mjs && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "highlight.js": "^11.12.0",
    "immer": "^10.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "homepage": "https://github.com/anomalyco/opencode"
}
